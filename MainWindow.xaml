<Window x:Class="LMUG29Leds.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LMUG29Leds"
        Width="820"
        Height="690"
        MinWidth="740"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        Foreground="#F0F3F6"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#151B23"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2A313C"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#8B949E"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F3F6"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PreviewButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#F0F3F6"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinWidth" Value="102"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="LMUG29Leds" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Le Mans Ultimate · Logitech G29"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border x:Name="AppStatusBorder"
                        Grid.Column="1"
                        Background="#382F16"
                        BorderBrush="#6E5B1E"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AppStatusDot"
                                 Width="8"
                                 Height="8"
                                 Fill="#D29922"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="AppStatusText"
                                   Text="Waiting"
                                   Foreground="#E3B341"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="WHEEL" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Ellipse x:Name="WheelStatusDot" Width="10" Height="10"
                                     Fill="#D29922" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="WheelStatusText" Text="Searching..."
                                       FontWeight="SemiBold" FontSize="15"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource CardBorder}"/>

                    <StackPanel Grid.Column="2" Margin="20,0">
                        <TextBlock Text="LE MANS ULTIMATE" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Ellipse x:Name="LmuStatusDot" Width="10" Height="10"
                                     Fill="#D29922" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="LmuStatusText" Text="Waiting for LMU"
                                       FontWeight="SemiBold" FontSize="15"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="3" Background="{StaticResource CardBorder}"/>

                    <StackPanel Grid.Column="4" Margin="20,0,0,0">
                        <TextBlock Text="CURRENT MODE" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ModeText" Text="Waiting"
                                   FontWeight="SemiBold" FontSize="15" Margin="0,7,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ENGINE RPM" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="RpmText" Text="0 / 0"
                                   Style="{StaticResource Value}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="THROTTLE" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ThrottleText" Text="0%"
                                   Style="{StaticResource Value}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="LIGHT BEHAVIOR" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="LedModeText" Text="Idle"
                                   Style="{StaticResource Value}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="6" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="LIGHT PATTERNS" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <TextBlock Text="Familiar G29 shift lights, plus a small number of useful states. Use Test on wheel to preview them on the physical LEDs."
                               Foreground="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RPM / Shift" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Normal driving" Foreground="{StaticResource SecondaryText}"
                                       FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="The five LEDs progressively illuminate as engine speed approaches the car's maximum RPM."
                                   Foreground="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="12,0,20,0"/>
                        <Button Grid.Column="2" x:Name="TestRpmButton" Content="Test on wheel"
                                Style="{StaticResource PreviewButton}" IsEnabled="False"/>
                    </Grid>

                    <Separator Background="{StaticResource CardBorder}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pit Limiter" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Limiter active" Foreground="{StaticResource SecondaryText}"
                                       FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="A scanner sweeps across the five LEDs while the pit-speed limiter is engaged."
                                   Foreground="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="12,0,20,0"/>
                        <Button Grid.Column="2" x:Name="TestPitButton" Content="Test on wheel"
                                Style="{StaticResource PreviewButton}" IsEnabled="False"/>
                    </Grid>

                    <Separator Background="{StaticResource CardBorder}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Shift Warning" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Near redline" Foreground="{StaticResource SecondaryText}"
                                       FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="All five LEDs flash when RPM reaches the final shift-warning range."
                                   Foreground="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="12,0,20,0"/>
                        <Button Grid.Column="2" x:Name="TestShiftButton" Content="Test on wheel"
                                Style="{StaticResource PreviewButton}" IsEnabled="False"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="7" Margin="2,16,2,0">
                <TextBlock Text="LMUG29Leds v0.1.0" Foreground="#6E7681" FontSize="11"/>
                <TextBlock Text="Local only · No network · No admin required"
                           Foreground="#6E7681"
                           FontSize="11"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
